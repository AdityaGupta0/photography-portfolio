---

import { Image, getImage } from 'astro:assets';
import type { Image as ImageType } from '../data/galleryData';

import "@fancyapps/ui/dist/fancybox/fancybox.css";


interface Props {
	images: ImageType[];
}

const { images } = Astro.props;

// Pre-generate full-resolution WebP images for the Fancybox lightbox
// These retain maximum quality so users see full detail in the viewer
const fancyboxSrcs = await Promise.all(
	images.map((image) =>
		getImage({ src: image.src, format: 'webp', quality: 95 })
	)
);
---

<section id="photo-grid" class="relative w-full mx-auto overflow-hidden">
	{
		images.map((image, index) => {
			const exif = image.exif;
			const shutter = exif?.shutterSpeed ?? 1;
			const shutterStr = shutter < 1 ? `1/${Math.round(1 / shutter)}` : `${shutter}`;
			const altText = `ISO ${exif?.iso ?? '-'} ${exif?.focalLength ?? '-'}mm ƒ${exif?.fNumber ?? '-'} ${shutterStr}s`;

			return (
				<a
					href={fancyboxSrcs[index].src}
					class="photo-item absolute transition-transform hover:scale-[1.02] hover:z-10 group"
					data-gallery="gallery1"
					data-type="image"
					style={'--width: ' + image.src.width + 'px; --height: ' + image.src.height + 'px;'}
					data-width={image.src.width}
					data-height={image.src.height}
					data-alt={altText}
					target="_blank"
					data-fancybox="gallery"
					data-caption={image.description}
				>
					<Image
						src={image.src}
						format="webp"
						quality={80}
						widths={[400, 800, 1200]}
						sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
						width={800}
						height={Math.round((800 * image.src.height) / image.src.width)}
						class="w-full h-full object-cover rounded-sm shadow-sm hover:shadow-lg transition-shadow duration-300 opacity-0 blur-sm will-change-filter will-change-opacity"
						loading={index < 2 ? "eager" : "lazy"}
						decoding="async"
						fetchpriority={index < 2 ? "high" : "auto"}
						alt={altText}
					/>
				</a>
			);
		})
	}
</section>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
  import { Lazyload } from "@fancyapps/ui/dist/carousel/carousel.lazyload.js";

  Fancybox.bind("[data-fancybox]", {
    theme: "dark",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
	  Thumbs: false,
      Arrows: true,
      Toolbar: {
        display: {
          left: [],
          middle: [],
          right: ["autoplay","toggleFull","fullscreen","close"],
        },
      },
      transition: "fade",
	  

	  formatCaption: (carouselRef, slide) => {
		return `
		<div style="text-align:center;">
		${slide.caption}
		</div>
		<div style="text-align:center;">
		${slide.alt}
		</div>
		`;
	  },
	  Lazyload: {preload: 2, showLoading: true,}
    },
  });
</script>

<script>
	import '../scripts/photo-grid';
</script>

<script>
// reveal images after they load (blur-up)
if (typeof window !== 'undefined') {
	const revealLoaded = () => {
		document.querySelectorAll('#photo-grid img').forEach((img) => {
			if ((img as HTMLImageElement).complete) {
				img.classList.remove('opacity-0','blur-sm');
				img.classList.add('opacity-100');
			} else {
				img.addEventListener('load', () => {
					img.classList.remove('opacity-0','blur-sm');
					img.classList.add('opacity-100');
				}, { once: true });
			}
		});
	};
	document.addEventListener('DOMContentLoaded', revealLoaded);
}
</script>
